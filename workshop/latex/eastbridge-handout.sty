\setlength{\parindent}{0pt}
\setlength{\parskip}{3pt plus 1pt}
\raggedbottom
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000
\emergencystretch=1em
\setlist[itemize]{leftmargin=1.35em,topsep=3pt,itemsep=3pt,parsep=0pt}
% A full-width tinted band with a solid bar at its left edge: #1 bar color,
% #2 band color, #3 content. Section headings and the field guide's tier
% bands share this shape.
\newcommand{\bandbox}[3]{%
  \noindent{\setlength{\fboxsep}{0pt}\colorbox{#2}{\hbox to\linewidth{%
    {\color{#1}\rule[-6pt]{3pt}{22pt}}\hspace{7pt}\rule[-6pt]{0pt}{22pt}#3\hfil}}}}
\newcommand{\sectionband}[1]{\bandbox{myblue}{myblue!10}{\large\bfseries #1}}
\titleformat{\section}[block]{}{}{0pt}{\sectionband}
\titlespacing*{\section}{0pt}{0pt}{9pt}
\titleformat{\subsection}{\normalsize\bfseries}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{8pt}{3pt}

% Small letterspaced labels: table column heads and step chips.
\newcommand{\smallcaps}[1]{\textls[70]{\MakeUppercase{#1}}}
\newcommand{\colhead}[1]{{\footnotesize\bfseries\color{black!50}\smallcaps{#1}}}
\newcommand{\chip}[2]{{\setlength{\fboxsep}{2.5pt}\colorbox{#1!12}{\scriptsize\bfseries\color{#1}\smallcaps{#2}}}}
\arrayrulecolor{black!40}

\newcommand{\workshoptitle}[2]{%
  \par\vspace*{1pt}
  {\LARGE\bfseries #1\par}
  \vspace{2pt}
  {\large\color{myblue}#2\par}
  \vspace{4pt}
  {\color{black!40}\hrule height .5pt}
  \vspace{8pt}}
\def\ucfirst#1#2\relax{\MakeUppercase{#1}#2}
\newcommand{\lessonstep}[2]{%
  \Needspace{5\baselineskip}
  \par\vspace{6pt}
  {\normalsize\chip{myblue}{#1}\enspace\bfseries\ucfirst#2\relax\par}\nobreak\vspace{1pt}}

% Throw pictographs: the raised fist, raised hand, victory hand and white
% question mark bitmaps from Noto Color Emoji (SIL Open Font License), stored
% as emoji-*.png so that pdfLaTeX can place them. \throws{RPS|Q} typesets one
% glyph per letter; a bar draws a divider.
\newcommand{\glyph}[1]{\raisebox{-3.6pt}{\includegraphics[height=14pt]{emoji-#1.png}}}
\newcommand{\tR}{\glyph{rock}}\newcommand{\tP}{\glyph{paper}}
\newcommand{\tS}{\glyph{scissors}}\newcommand{\tQ}{\glyph{question}}
\newcommand{\gap}{\hspace{1.5pt}}
\newcommand{\sep}{{\color{black!35}\ \textbar\ }}
\newcommand{\throws}[1]{\throwsloop#1\relax}
\def\throwsloop#1{\ifx\relax#1\else\throwglyph{#1}\expandafter\throwsloop\fi}
\def\throwglyph#1{\if|#1\sep\else\csname t#1\endcsname\gap\fi}

% Callout boxes: a tint with a solid bar down the left edge.
