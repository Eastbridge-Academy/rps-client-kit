% Eastbridge Academy workshop style.
% Adapted from courses/resources/template.tex and projects/chess-bot/week1.tex.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{eastbridge-handout}[2026/09/10 Eastbridge RPS handouts]
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage{amsmath,amssymb,mathtools}
\RequirePackage{microtype}
\RequirePackage{graphicx,xcolor}
\RequirePackage{geometry,fancyhdr}
\RequirePackage{array,booktabs,tabularx}
\RequirePackage{mdframed,needspace}
\RequirePackage{listings,upquote}
\RequirePackage{enumitem}
\RequirePackage[english]{babel}
\RequirePackage[autostyle,english=american]{csquotes}
\RequirePackage{titlesec}
\RequirePackage{xurl}
\RequirePackage[unicode]{hyperref}

% The same Solarized palette as the course handouts.
\definecolor{myred}{RGB}{220,50,47}
\definecolor{myblue}{RGB}{38,139,210}
\definecolor{mygreen}{RGB}{133,153,0}
\definecolor{myorange}{RGB}{203,75,22}
\definecolor{myyellow}{RGB}{181,137,0}
\definecolor{codecomment}{RGB}{101,123,131}
\definecolor{codebg}{RGB}{253,246,227}
\hypersetup{colorlinks=true,urlcolor=myblue,linkcolor=black,
  pdfauthor={Eastbridge Academy},pdfcreator={Eastbridge Academy / pdfLaTeX}}
\urlstyle{same}

\geometry{letterpaper,margin=1in,headheight=43pt,headsep=12pt,footskip=27pt}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\raisebox{-0.2\height}{\includegraphics[height=14pt]{eastbridge-logo.pdf}}}
\fancyhead[R]{\small\textsf{RPS Workshop\quad\textbullet\quad\routelabel}}
\renewcommand{\headrulewidth}{0.2pt}
\fancyfoot[C]{\thepage}
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyhead[L]{\raisebox{-0.2\height}{\includegraphics[height=42pt]{eastbridge-logo.pdf}}}
  \fancyhead[R]{\small\textsf{RPS Workshop\quad\textbullet\quad\routelabel}}
  \renewcommand{\headrulewidth}{0.2pt}
  \fancyfoot[C]{\thepage}}

\setlength{\parindent}{0pt}
\setlength{\parskip}{3pt plus 1pt}
\raggedbottom
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000
\emergencystretch=1em
\setlist[itemize]{leftmargin=1.35em,topsep=3pt,itemsep=3pt,parsep=0pt}
\titleformat{\section}{\Large\bfseries}{}{0pt}{}
\titlespacing*{\section}{0pt}{0pt}{8pt}
\titleformat{\subsection}{\normalsize\bfseries}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{8pt}{3pt}

\newcommand{\workshoptitle}[2]{%
  \par\vspace*{1pt}
  {\centering\LARGE\bfseries #1\par}
  \vspace{3pt}
  {\centering\large\color{myblue}#2\par}
  \vspace{5pt}}
\newcommand{\lessonstep}[2]{%
  \Needspace{5\baselineskip}
  \par\vspace{5pt}
  {\normalsize\bfseries #1.\enspace #2\par}\nobreak}

\mdfdefinestyle{eastbridgebox}{skipabove=5pt,skipbelow=5pt,
  innerleftmargin=10pt,innerrightmargin=10pt,
  innertopmargin=7pt,innerbottommargin=7pt}
\newmdenv[style=eastbridgebox,backgroundcolor=black!5,linewidth=0pt]{context}
\newmdenv[style=eastbridgebox,linecolor=myblue,linewidth=1pt,
  backgroundcolor=myblue!3,nobreak=true]{checkpoint}
\newmdenv[style=eastbridgebox,linecolor=myorange,linewidth=1.1pt,
  backgroundcolor=myorange!3,nobreak=true]{summit}

\lstdefinestyle{python}{language=Python,
  basicstyle=\ttfamily\footnotesize,
  keywordstyle=\color{myblue}\bfseries,
  stringstyle=\color{myorange},
  commentstyle=\color{codecomment}\itshape,
  numberstyle=\tiny\color{codecomment},
  backgroundcolor=\color{codebg},
  frame=single,framerule=0.4pt,rulecolor=\color{black!20},
  numbers=left,numbersep=7pt,xleftmargin=15pt,xrightmargin=4pt,
  framexleftmargin=4pt,framexrightmargin=4pt,framesep=4pt,
  breaklines=true,breakatwhitespace=false,breakindent=12pt,
  columns=fullflexible,keepspaces=true,showstringspaces=false,
  upquote=true,tabsize=4,aboveskip=7pt,belowskip=7pt,
  morekeywords={True,False,None},literate={-}{-}1}
\lstdefinestyle{shell}{style=python,language=bash,numbers=none,
  morekeywords={uv,rps-cli,cd,source},xleftmargin=5pt}
\lstdefinestyle{plaincode}{style=python,language={},numbers=none,xleftmargin=5pt}

\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcommand{\code}[1]{{\ttfamily\small #1}}

% Unlike the old courses preamble, quotes are not made globally active:
% literal Python and shell quotes must survive inside inline code as well.
\pdfgentounicode=1
\input{glyphtounicode}
